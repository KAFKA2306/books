{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kafka2306.github.io/books/data/catalog.schema.json",
  "title": "KAFKA Books Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "key_policy",
    "stats",
    "works",
    "editions",
    "holdings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "key_policy": {
      "type": "object"
    },
    "stats": {
      "type": "object"
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "editions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edition"
      }
    },
    "holdings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/holding"
      }
    },
    "issue_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issueRecord"
      }
    },
    "issue_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "work_id",
          "action"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "work_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "skipped_duplicate_holding",
              "added_new_holding"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "work": {
      "type": "object",
      "required": [
        "work_id",
        "title",
        "title_key",
        "category",
        "status",
        "item_count",
        "isbn_status"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^wrk_[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "title_key": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string"
        },
        "status": {
          "enum": [
            "read",
            "reading",
            "unread",
            "untracked"
          ]
        },
        "progress": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "price_yen": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        },
        "isbn_count": {
          "type": "integer",
          "minimum": 0
        },
        "isbn_status": {
          "enum": [
            "verified",
            "partial",
            "missing"
          ]
        }
      }
    },
    "edition": {
      "type": "object",
      "required": [
        "edition_id",
        "id_kind",
        "work_id",
        "isbn13",
        "verification"
      ],
      "properties": {
        "edition_id": {
          "type": "string"
        },
        "id_kind": {
          "enum": [
            "isbn13",
            "jan",
            "pending_title_key",
            "source_scoped"
          ]
        },
        "work_id": {
          "type": "string"
        },
        "isbn13": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{13}$"
        },
        "verification": {
          "enum": [
            "verified",
            "verified_without_isbn",
            "unverified",
            "rejected"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "jan": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "holding": {
      "type": "object",
      "required": [
        "holding_id",
        "work_id",
        "source",
        "format",
        "quantity"
      ],
      "properties": {
        "holding_id": {
          "type": "string"
        },
        "work_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "issueRecord": {
      "type": "object",
      "required": [
        "ordinal",
        "canonical_title",
        "work_title",
        "title_key",
        "work_id",
        "category",
        "holding",
        "editions"
      ],
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "canonical_title": {
          "type": "string",
          "minLength": 1
        },
        "work_title": {
          "type": "string",
          "minLength": 1
        },
        "title_key": {
          "type": "string",
          "minLength": 1
        },
        "work_id": {
          "type": "string",
          "pattern": "^wrk_[0-9a-f]{12}$"
        },
        "category": {
          "type": "string"
        },
        "holding": {
          "type": "object",
          "required": [
            "source",
            "format"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "edition_id",
              "title",
              "verification",
              "source_url"
            ],
            "properties": {
              "edition_id": {
                "type": "string"
              },
              "isbn13": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{13}$"
              },
              "jan": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "authors": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publisher": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "format": {
                "type": "string"
              },
              "verification": {
                "enum": [
                  "verified",
                  "verified_without_isbn"
                ]
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
